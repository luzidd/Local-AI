# .env — Environment overrides for docker compose
# Copy this file to .env and adjust values for your hardware.
# docker compose automatically reads .env from the compose file's directory.

# Number of CPU threads Ollama will use for inference.
# Rule of thumb: set to your physical core count (not logical/hyperthreads).
# Example: 6-core CPU → 6, 8-core → 8, 16-core → 12 (leave some for OS)
OLLAMA_NUM_THREADS=8

# Absolute path to the project directory mounted into the omp container.
# Defaults to ./workspace if unset.
# Windows example: WORKSPACE_DIR=C:/Users/yourname/projects/myrepo
WORKSPACE_DIR=
