# Gemma 4 26B — CPU-optimised Modelfile
#
# Base: gemma4:26b (Mixture of Experts, 25.2B total / 3.8B active params)
# Quantization: Q4_K_M (~18 GB RAM) — suitable for 32 GB RAM CPU-only hosts
#
# To switch to Q8 (requires ~32 GB free RAM, not recommended with 32 GB total):
#   FROM gemma4:26b-q8_0
# Note: pull the Q8 variant first with: ollama pull gemma4:26b-q8_0
FROM gemma4:26b

# --- Sampling parameters (Google's recommended baseline for Gemma 4) ---
PARAMETER temperature 1.0
PARAMETER top_p 0.95
PARAMETER top_k 64

# --- Context window ---
# 256K is Gemma 4's maximum, but KV cache scales with context.
# KV cache for Gemma 4 26B MoE at 65K ≈ 6–7 GB; safe on 32 GB with the
# Q4 weights at ~18 GB. omp's tool definitions consume ~16K tokens of
# fixed overhead, so a larger window keeps that overhead below 25%.
PARAMETER num_ctx 65536

# --- CPU thread count ---
# Set to your physical core count (not logical/hyperthreaded).
# Overridden at runtime by OLLAMA_NUM_THREADS env var; this is a fallback.
PARAMETER num_thread 8

# --- Thinking mode ---
# Gemma 4 supports optional chain-of-thought via <|think|> in system prompt.
# oh-my-pi controls this via the system prompt; no change needed here.

# --- Stop sequences ---
PARAMETER stop "<end_of_turn>"
PARAMETER stop "<eos>"
